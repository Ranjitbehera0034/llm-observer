# LLM Observer License Server — Environment Variables
# Set these in the Vercel project for packages/license-server (Settings → Environment Variables).
# Check what's configured at GET /health.

## REQUIRED

# Ed25519 private key that signs license keys. Generate with:
#   npm run keygen --workspace=@llm-observer/license-server
# The matching public key must be in packages/proxy/src/licenseKeys.ts.
LICENSE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Webhook signing secrets. Webhooks are REJECTED when these are missing.
LEMONSQUEEZY_WEBHOOK_SECRET=your_lemonsqueezy_webhook_signing_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Resend API key + sender for emailing license keys
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=licenses@llm-observer.com

## OWNER VIEW (/admin.html)

# Customer, activation and install records. Easiest: add the "Upstash for Redis"
# integration in Vercel → Storage, which sets these two automatically.
KV_REST_API_URL=https://your-db.upstash.io
KV_REST_API_TOKEN=your_upstash_rest_token

# Password for /admin.html and GET /admin/report. Generate: openssl rand -hex 24
ADMIN_TOKEN=your-admin-token-16-plus-chars

## RAZORPAY CHECKOUT (landing page "Pay via UPI")
RAZORPAY_KEY_ID=rzp_live_xxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_PRO_AMOUNT_PAISE=29900
CHECKOUT_CALLBACK_URL=https://www.llm-observer.com/?paid=1

## LEGACY (only needed if you issued PRO_ keys before 2.0.1)

# The HMAC secret old PRO_ keys were signed with (LICENSE_SECRET also accepted).
LICENSE_SIGNING_SECRET=
# Set to "true" only if early keys were issued while no secret was being read
# (they were signed with the public fallback and are forgeable). Turn off once
# those customers have new LLMO1 keys.
ALLOW_LEGACY_DEV_SECRET=false

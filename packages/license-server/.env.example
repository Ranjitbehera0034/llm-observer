# Configure secrets in the deployment dashboard; never put them in public builds.
LICENSE_SIGNING_SECRET=
RESEND_API_KEY=
EMAIL_FROM=licenses@yourdomain.com
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_VARIANT_IDS=
LEMONSQUEEZY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
CHECKOUT_CALLBACK_URL=https://www.llm-observer.com/thanks
# Test deployment only. Never enable this in production.
PAYMENTS_TEST_MODE=false

# Optional owner customer dashboard + opt-in application activity.
# Apply sql/customer-reporting.sql to a Supabase project first.
CUSTOMER_STORE_URL=https://YOUR_PROJECT.supabase.co/rest/v1
CUSTOMER_STORE_SERVICE_KEY=
# Generate a separate random value, at least 32 characters. Never ship to clients.
CUSTOMER_ADMIN_TOKEN=
# The following must also appear in LEMONSQUEEZY_VARIANT_IDS.
LEMONSQUEEZY_MONTHLY_VARIANT_ID=
LEMONSQUEEZY_YEARLY_VARIANT_ID=
